# Copy to .env and fill in. .env is gitignored; this file documents every var.

# --- Phase 1 ---
# Connection string for the pgvector Postgres from docker-compose.yml.
DATABASE_URL=postgresql://rag:ragpass@localhost:5433/ragdb

# Embeddings. EMBED_PROVIDER picks where they come from:
#   api   (default) any OpenAI-compatible /embeddings endpoint, reusing
#         OPENAI_BASE_URL + OPENAI_API_KEY below. NOTE: with this setting the
#         app CANNOT RETRIEVE AT ALL if the endpoint is unreachable.
#   local sentence-transformers in-process — free, offline, no key.
# EMBED_DIM MUST match the model; it defines the vector(...) column width, and
# changing it requires `python -m ingestion.migrate_embeddings --yes` plus a
# full re-ingest (old vectors are meaningless in a new space).
EMBED_PROVIDER=api
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
# Local alternative (bge-base-en-v1.5 matched 3-small in the bake-off, for free):
#   EMBED_PROVIDER=local
#   EMBED_MODEL=BAAI/bge-base-en-v1.5
#   EMBED_DIM=768
#
# API-provider tuning (ignored when EMBED_PROVIDER=local):
EMBED_TIMEOUT=60      # seconds per embeddings call
EMBED_RETRIES=4       # attempts per batch on transient failures
EMBED_BACKOFF=2.0     # linear backoff base: sleep = BACKOFF * attempt
EMBED_BATCH=64        # inputs per HTTP request
EMBED_MAX_CHARS=24000 # hard per-input clip (3-small accepts 8191 tokens)

# --- Phase 2+ (unused in Phase 1) ---
# Generation runs against any OpenAI-compatible endpoint (base_url + model + key).
#
# PRIMARY — OpenRouter (hosted, OpenAI-compatible; one key, many models):
OPENAI_BASE_URL=https://openrouter.ai/api/v1
GEN_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-or-v1-...   # your OpenRouter key
#
# Local fallback — a llama.cpp server on the LAN (phi-4). Swap in by uncommenting
# these three and commenting the PRIMARY block above (any non-empty key works
# locally); point the host at wherever your llama.cpp server listens:
#   OPENAI_BASE_URL=http://localhost:8080/v1
#   GEN_MODEL=phi-4-Q4_K_M.gguf
#   OPENAI_API_KEY=ollama
#
# Other OpenAI-compatible options (base_url / model / key):
#   OpenAI direct : https://api.openai.com/v1                         · gpt-4o-mini      · sk-...
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/ · gemini-2.0-flash · <AI Studio key>

# Per-request generation timeout in seconds. Local inference is slow; bump this
# if a large local model times out on long answers.
GEN_TIMEOUT=60
# Ceiling on generated tokens per answer. Without it an answer is bounded only by
# the model's context window (OpenRouter injects no default of its own). Measured
# answers run 52-216 tokens, so this is deliberately generous: the ceiling caps
# output rather than reserving it, so unused headroom costs nothing. Lower it
# carefully. A ceiling that clips long item lists regresses the
# exhaustive-enumeration result in eval/results.md, and hitting it logs a
# `generation_truncated` warning.
GEN_MAX_TOKENS=4096

# Reranker is local (sentence-transformers), unaffected by the provider choice.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Phase 3 (API serving layer) ---
# Comma-separated CORS origins allowed to call the API. Default is the Vite dev
# server; set to your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173
# Per-IP rate limit for /ask (requests per rolling minute).
RATE_LIMIT_PER_MIN=30
# Longest accepted question, in characters. The rate limit caps how OFTEN a
# caller can spend; this caps how MUCH one call can spend, since the question is
# interpolated into the generation prompt verbatim. Over-long bodies are rejected
# with 422 before anything is embedded or generated.
MAX_QUESTION_CHARS=500
# Corpora hidden from /corpora (and so from the UI switcher). The product is the
# League of Legends face; the FastAPI corpus is retained in-repo as engineering
# history but not surfaced. 'smoke' is the reseeded smoke-test corpus.
EXCLUDED_CORPORA=smoke,fastapi
