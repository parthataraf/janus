# Deploy config for docker-compose.deploy.yml. Copy to `.env` on the server and
# fill in. This file (the example) is safe to commit; the real .env is NOT —
# it's gitignored and holds the generation key + DB password.
#
#   cp .env.deploy.example .env   # then edit

# --- Domain / TLS -----------------------------------------------------------
# Production: your public hostname, BARE (no scheme); Caddy provisions HTTPS
# automatically via Let's Encrypt.
#   DOMAIN=janus.example.com
# Local test: use the http:// SCHEME to serve plain HTTP on :80 (no TLS).
# Do NOT use a bare 'localhost' — without the scheme Caddy tries to obtain a
# public certificate for it and the stack won't serve.
DOMAIN=http://localhost

# --- Database (pgvector) ----------------------------------------------------
# These init the db container AND build the api's DATABASE_URL. Do NOT set
# DATABASE_URL yourself: docker-compose.deploy.yml derives it from these three
# and points it at the internal 'db' service (any DATABASE_URL you add is ignored).
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ragdb

# --- Generation (hosted, OpenAI-compatible endpoint) ------------------------
# Called at request time; NEVER baked into an image. Any OpenAI-compatible API
# works via base_url. This project's primary is OpenRouter:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
GEN_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-or-v1-...          # your OpenRouter key
GEN_TIMEOUT=60
# (OpenAI direct works too: OPENAI_BASE_URL=https://api.openai.com/v1 · gpt-4o-mini · sk-...)

# --- Serving hygiene --------------------------------------------------------
# CORS = the FULL browser origin (scheme + host), matching the address bar:
# https://<your-domain> in production, http://localhost locally. With Caddy the
# browser is same-origin, so this is defense-in-depth.
CORS_ORIGINS=http://localhost
# Per-IP rate limit for /ask (requests/minute). On by default.
RATE_LIMIT_PER_MIN=30
# Corpora hidden from /corpora and the UI. The deployed product is the League of
# Legends face; the FastAPI corpus is kept in-repo (engineering history) but not
# ingested or surfaced. 'smoke' is the reseeded smoke-test corpus.
EXCLUDED_CORPORA=smoke,fastapi

# --- Models -----------------------------------------------------------------
# Embeddings are served by the SAME OpenAI-compatible provider as generation
# (OPENAI_BASE_URL / OPENAI_API_KEY above). This is a HARD RUNTIME DEPENDENCY:
# if that endpoint is unreachable the server cannot embed the query, therefore
# cannot search, and /ask refuses honestly instead of answering badly.
# Set EMBED_PROVIDER=local (+ EMBED_MODEL/EMBED_DIM of a sentence-transformers
# model) to remove that dependency at the cost of retrieval quality.
EMBED_PROVIDER=api
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
EMBED_TIMEOUT=60
EMBED_RETRIES=4
# The reranker stays LOCAL and is baked into the API image.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_THRESHOLD=0.0
