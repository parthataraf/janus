# Janus frontend image: build the Vite app, serve the static bundle with nginx.
# VITE_API_BASE is baked at build time; in the deploy stack it's "/api", which
# Caddy strips and proxies to the api service (so the browser only ever talks to
# one origin).
FROM node:22-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM nginx:alpine
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
